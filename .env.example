# =============================================================
# BRIK STUDIO - Variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` esta en .gitignore: nunca se sube al repositorio.
# =============================================================

# --- Formulario de contacto (opcional) ---------------------------------
# El sitio funciona perfectamente SIN estas variables: el CTA principal es
# WhatsApp. Si no las defines, el formulario de email se oculta solo.
#
# 1. Crea una cuenta gratuita en https://resend.com
# 2. Genera una API key en https://resend.com/api-keys
RESEND_API_KEY=

# Remitente de los emails. Debe ser un dominio verificado en Resend.
# Para probar sin dominio propio puedes usar: onboarding@resend.dev
RESEND_FROM="BRIK STUDIO <onboarding@resend.dev>"

# Direccion donde quieres RECIBIR los mensajes del formulario.
CONTACT_EMAIL=

# --- Metadatos del sitio (opcional) ------------------------------------
# URL publica final. Se usa para las etiquetas Open Graph / SEO.
NEXT_PUBLIC_SITE_URL=https://brik-studio.vercel.app
